#!/usr/bin/env perl

use strict;
use warnings;

use Cwd qw(abs_path);
use File::Copy qw(copy);
use File::Find qw(find);
use File::Path qw(make_path);
use File::Spec;

sub usage {
    die <<'USAGE';
Usage: ./sync-agent-skills [--check|--sync]
                           [--from-perl|--from-mirror]
                           [--xperl]
                           [--prune] [PERL_ROOT]

The defaults are --check and --from-perl. The Perl guidance lives in
PERL_ROOT/AGENTS.md, PERL_ROOT/CLAUDE.md, and PERL_ROOT/.agents/skills; the
legacy mirror is under perl_agents in this repository.
XPerl-specific skills are under xperl_agents and require --xperl.

--sync         Copy changed and missing source files to the destination.
--from-perl    Use the Perl skill tree as the source (the default).
--from-mirror  Use the legacy mirror as the source.
--xperl        Include XPerl skills as well as generic Perl skills.
--prune        With --sync, remove destination files absent from the source.
USAGE
}

my $mode = 'check';
my $direction = 'from-perl';
my $direction_seen;
my $prune = 0;
my $include_xperl = 0;
my @args;
for my $arg (@ARGV) {
    if ($arg eq '--check') {
        $mode = 'check';
    }
    elsif ($arg eq '--sync') {
        $mode = 'sync';
    }
    elsif ($arg eq '--from-perl' || $arg eq '--from-mirror') {
        usage()
            if defined($direction_seen) && $direction_seen ne $arg;
        $direction = $arg;
        $direction_seen = $arg;
    }
    elsif ($arg eq '--prune') {
        $prune = 1;
    }
    elsif ($arg eq '--xperl') {
        $include_xperl = 1;
    }
    elsif ($arg eq '--help' || $arg eq '-h') {
        usage();
    }
    elsif ($arg =~ /^-/) {
        usage();
    }
    else {
        push @args, $arg;
    }
}
usage() if @args > 1;

my $script = abs_path($0) or die "cannot resolve $0: $!\n";
my (undef, $mirror_dir, undef) = File::Spec->splitpath($script);
my $mirror_root = abs_path($mirror_dir)
    or die "cannot resolve perl_core_skillz checkout\n";
my $perl_root = $args[0]
    || $ENV{PERL_ROOT}
    || File::Spec->catdir($mirror_root, File::Spec->updir(), 'perl');
$perl_root = abs_path($perl_root) if -d $perl_root;
die "Perl checkout not found: $perl_root\n" unless -d $perl_root;

my $perl_skills = File::Spec->catdir($perl_root, '.agents', 'skills');
my $mirror_skills = File::Spec->catdir($mirror_root, 'perl_agents', 'skills');
my $xperl_skills = File::Spec->catdir($mirror_root, 'xperl_agents', 'skills');
my $perl_wrappers = $perl_root;
my $mirror_wrappers = File::Spec->catdir($mirror_root, 'perl_agents');
die "perl_core_skillz checkout not found: $mirror_root\n" unless -d $mirror_root;

my ($source, $target, $target_name) = $direction eq 'from-perl'
    ? ($perl_skills, $mirror_skills, 'mirror')
    : ($mirror_skills, $perl_skills, 'Perl checkout');
die "source skill directory not found: $source\n" unless -d $source;

sub relative_files {
    my ($root) = @_;
    my @files;
    find({
        no_chdir => 1,
        wanted => sub {
            return unless -f $_;
            push @files, File::Spec->abs2rel($File::Find::name, $root);
        },
    }, $root);
    return sort @files;
}

sub is_xperl_skill {
    my ($file) = @_;
    return $file =~ m{\Axperl-}
        || $file =~ m{\Aperl-structured-(?:exceptions|diagnostics|diagnostic-inventory)/};
}

# Scope the file list before comparing or pruning. A generic restoration
# leaves an existing XPerl supplement untouched.
sub selected_files {
    my ($root, $canonical) = @_;
    my @files = -d $root ? relative_files($root) : ();

    if ($canonical) {
        @files = grep { $include_xperl || !is_xperl_skill($_) } @files;
    }
    else {
        die "XPerl skill found in generic mirror: $_\n"
            for grep { is_xperl_skill($_) } @files;

        if ($include_xperl && -d $xperl_skills) {
            my @xperl_files = relative_files($xperl_skills);
            die "generic skill found in XPerl mirror: $_\n"
                for grep { !is_xperl_skill($_) } @xperl_files;
            push @files, @xperl_files;
        }
    }

    return @files;
}

sub skill_path {
    my ($root, $canonical, $file) = @_;
    $root = $xperl_skills if !$canonical && is_xperl_skill($file);
    return File::Spec->catfile($root, $file);
}

sub same_file {
    my ($left, $right) = @_;
    return 0 unless -f $right;
    open my $a, '<:raw', $left or die "open $left: $!\n";
    open my $b, '<:raw', $right or die "open $right: $!\n";
    local $/;
    my $left_data = <$a>;
    my $right_data = <$b>;
    return defined($left_data) && defined($right_data) && $left_data eq $right_data;
}

sub slurp {
    my ($file) = @_;
    open my $fh, '<:raw', $file or die "open $file: $!\n";
    local $/;
    return <$fh>;
}

sub adapt_wrapper {
    my ($data, $file, $layout) = @_;

    if ($file eq 'AGENTS.md') {
        my $section = $layout eq 'perl' ? <<'PERL_AGENTS' : <<'MIRROR_AGENTS';
## Agent Skills

Repository-specific skill files live in `.agents/skills/`. Read the relevant
skill before editing the associated subsystem.

This is the canonical skill tree. From the sibling `perl_core_skillz`
repository, run `./sync-agent-skills --check` to verify its legacy mirror, or
use `./sync-agent-skills --sync` to update it. Use `--from-mirror` to restore
the guidance and skill tree to a Perl branch which does not contain them.

Generic skills are mirrored under `perl_agents/skills/`. Skills named
`xperl-*` apply only to XPerl and are mirrored under `xperl_agents/skills/`.
Use `--xperl` with the synchronizer to include those skills. Omit it when
restoring guidance for an ordinary Perl checkout.

PERL_AGENTS
## Agent Skills

Repository-specific skill files live in `skills/`. Read the relevant
skill before editing the associated subsystem.

The canonical skills live in the sibling `perl` checkout. From the
`perl_core_skillz` repository root, run `./sync-agent-skills --check` to verify
this mirror, or use `./sync-agent-skills --sync` to update it. Use
`--from-mirror` to reverse the direction after reviewing mirror changes or
when restoring the guidance and skill tree to a Perl branch which does not
contain them.

XPerl-specific skills are kept separately in `../xperl_agents/skills/`.
Include them with `--xperl` only when the target checkout is XPerl.

MIRROR_AGENTS
        $data =~ s/^## Agent Skills\n.*?(?=^## )/$section/ms
            or die "cannot adapt Agent Skills section in $file\n";
    }
    elsif ($file eq 'CLAUDE.md') {
        my $section = $layout eq 'perl' ? <<'PERL_CLAUDE' : <<'MIRROR_CLAUDE';
Repository-specific skill files are located in `.agents/skills/`. Read the
relevant `SKILL.md` file before working on the matching subsystem, and follow
its referenced files as needed.

The `.agents/skills` tree is canonical. Its legacy mirror is in
`../perl_core_skillz/perl_agents/skills`; there is no separate
`.claude/skills` mirror in this repository.

PERL_CLAUDE
Repository-specific skill files are located in `skills/`. Read the relevant
`SKILL.md` file before working on the matching subsystem, and follow its
referenced files as needed.

The `skills` tree is the legacy mirror of the canonical skill source in
`../../perl/.agents/skills`. There is no separate `.claude/skills` mirror in
this repository.

MIRROR_CLAUDE
        $data =~ s/^Repository-specific skill files .*?(?=^## Companion instructions)/$section/ms
            or die "cannot adapt skill location in $file\n";
    }

    return $data;
}

sub write_file {
    my ($file, $data, $mode) = @_;
    open my $fh, '>:raw', $file or die "open $file: $!\n";
    print {$fh} $data or die "write $file: $!\n";
    close $fh or die "close $file: $!\n";
    chmod($mode, $file) or die "chmod $file: $!\n";
}

my $source_is_canonical = $direction eq 'from-perl';
my $target_is_canonical = !$source_is_canonical;
my %source = map { $_ => 1 } selected_files($source, $source_is_canonical);
my %target = map { $_ => 1 } selected_files($target, $target_is_canonical);
my %all = map { $_ => 1 } keys(%source), keys(%target);
my (@missing, @different, @extra);
for my $file (sort keys %all) {
    my $left = skill_path($source, $source_is_canonical, $file);
    my $right = skill_path($target, $target_is_canonical, $file);
    if (!$source{$file}) {
        push @extra, $file;
    }
    elsif (!$target{$file}) {
        push @missing, $file;
    }
    elsif (!same_file($left, $right)) {
        push @different, $file;
    }
}

if ($mode eq 'check') {
    print "missing from $target_name: $_\n" for @missing;
    print "different in $target_name: $_\n" for @different;
    print "extra in $target_name: $_\n" for @extra;
    my $wrapper_problem = 0;
    for my $file (qw(AGENTS.md CLAUDE.md)) {
        my $left = File::Spec->catfile(
            $direction eq 'from-perl' ? $perl_wrappers : $mirror_wrappers,
            $file,
        );
        my $right = File::Spec->catfile(
            $direction eq 'from-perl' ? $mirror_wrappers : $perl_wrappers,
            $file,
        );
        if (!-f $left) {
            print "missing from source: $file\n";
            $wrapper_problem = 1;
            next;
        }
        my $layout = $direction eq 'from-perl' ? 'mirror' : 'perl';
        my $expected = adapt_wrapper(slurp($left), $file, $layout);
        if (!-f $right) {
            print "missing from $target_name: $file\n";
            $wrapper_problem = 1;
        }
        elsif (slurp($right) ne $expected) {
            print "different in $target_name: $file\n";
            $wrapper_problem = 1;
        }
    }
    print "guidance and selected skill trees are synchronized\n"
        unless @missing || @different || @extra || $wrapper_problem;
    exit(@missing || @different || @extra || $wrapper_problem ? 1 : 0);
}

make_path($target) unless -d $target;
for my $file (@missing, @different) {
    my $left = skill_path($source, $source_is_canonical, $file);
    my $right = skill_path($target, $target_is_canonical, $file);
    my ($volume, $directories) = File::Spec->splitpath($right);
    make_path($directories) unless -d $directories;
    copy($left, $right) or die "copy $left -> $right: $!\n";
    chmod((stat($left))[2] & 07777, $right) or die "chmod $right: $!\n";
    print "updated $file\n";
}
if ($prune) {
    for my $file (@extra) {
        my $right = skill_path($target, $target_is_canonical, $file);
        unlink $right or die "unlink $right: $!\n";
        print "removed $file\n";
    }
}
elsif (@extra) {
    print "left $target_name-only files untouched (use --prune to remove them):\n";
    print "  $_\n" for @extra;
}

my $wrapper_problem = 0;
for my $file (qw(AGENTS.md CLAUDE.md)) {
    my $left = File::Spec->catfile(
        $direction eq 'from-perl' ? $perl_wrappers : $mirror_wrappers,
        $file,
    );
    my $right = File::Spec->catfile(
        $direction eq 'from-perl' ? $mirror_wrappers : $perl_wrappers,
        $file,
    );
    if (!-f $left) {
        warn "cannot update $file: source file is missing\n";
        $wrapper_problem = 1;
        next;
    }
    my $layout = $direction eq 'from-perl' ? 'mirror' : 'perl';
    my $data = adapt_wrapper(slurp($left), $file, $layout);
    next if -f $right && slurp($right) eq $data;
    write_file($right, $data, (stat($left))[2] & 07777);
    print "updated $file\n";
}

exit($wrapper_problem ? 1 : 0);
